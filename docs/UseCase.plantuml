@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam arrowColor #222222
skinparam actorBorderColor #222222
skinparam usecaseBorderColor #222222
skinparam usecaseBackgroundColor #FFFFFF

actor "Администратор" as Admin

rectangle "TechSupport — Учёт заявок в техподдержку" {
    usecase "Войти в систему" as UC_Login
    usecase "Зарегистрировать администратора" as UC_RegAdmin
    usecase "Просмотреть все заявки" as UC_ViewAll
    usecase "Фильтровать и сортировать заявки" as UC_Filter
    usecase "Назначить исполнителя" as UC_Assign
    usecase "Изменить статус заявки" as UC_ChangeStatus
    usecase "Закрыть заявку" as UC_Close

    usecase "Зарегистрироваться" as UC_Register
    usecase "Создать заявку" as UC_CreateTicket
    usecase "Просмотреть свои заявки" as UC_ViewMy
    usecase "Просмотреть статус заявки" as UC_ViewStatus

    UC_Filter .> UC_ViewAll : <<extend>>
}

actor "Пользователь" as User

Admin --> UC_Login
Admin --> UC_RegAdmin
Admin --> UC_ViewAll
Admin --> UC_Assign
Admin --> UC_ChangeStatus
Admin --> UC_Close

UC_Login <-- User
UC_Register <-- User
UC_CreateTicket <-- User
UC_ViewMy <-- User
UC_ViewStatus <-- User
@enduml
